{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Switchboard",
  "version": "../package.json",
  "identifier": "io.github.choco5958.switchboard",
  "build": {
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Switchboard",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#0f1424",
        "visible": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/switchboard-node"
    ],
    "resources": {
      "../out/tauri/node/": "node/"
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "13.5"
    },
    "linux": {
      "deb": {
        "depends": [
          "libxss1"
        ],
        "conflicts": [
          "claude-ide"
        ],
        "replaces": [
          "claude-ide"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
