{
  "name": "claude-ide",
  "version": "0.1.0",
  "private": true,
  "description": "Switchboard: a desktop app for running several Claude Code sessions at once: decision queue, tasks, progress graph, work log",
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "setup": "sh scripts/setup.sh",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node --test bridge/*.test.ts mcp/*.test.ts mod/tests/*.unit.ts && vitest run src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
