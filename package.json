{
  "name": "claude-ide",
  "version": "0.3.8",
  "private": true,
  "description": "Switchboard: a desktop app for running several Claude Code sessions at once: decision queue, tasks, progress graph, work log",
  "license": "MIT",
  "author": "choco5958",
  "homepage": "https://github.com/choco5958/switchboard",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "setup": "sh scripts/setup.sh",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "test": "node --import ./scripts/test-env.ts --test bridge/*.test.ts mcp/*.test.ts mod/tests/*.unit.ts scripts/*.test.ts && vitest run src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "d2coding": "1.3.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "pretendard": "1.3.9",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0"
  }
}
